# Providence Auto — environment variables
# Copy to .env.local for local dev, and set the same keys on each Railway
# service (dev / staging / production). Values below are placeholders.

# ── Database (Railway Postgres) — required for app, migrations, build ─────────
# DATABASE_URL is the default the app + drizzle use.
DATABASE_URL=postgresql://user:pass@host:port/railway
DATABASE_URL_STAGING=postgresql://user:pass@host:port/railway
DATABASE_URL_PRODUCTION=postgresql://user:pass@host:port/railway

# ── Auth (Better-Auth) ───────────────────────────────────────────────────────
BETTER_AUTH_SECRET=          # any long random string
NEXT_PUBLIC_BASE_URL=        # e.g. https://providenceauto.uk.com (http://localhost:3000 for dev)
# Optional social providers:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# ── Sourcing & Profit Analyzer (admin) — REQUIRED for that tool to work ───────
# Without these, the live tool reports "GEMINI_API_KEY is not configured" /
# "APIFY_TOKEN is not configured".
GEMINI_API_KEY=              # Google AI Studio key — auction-sheet extraction + buy/avoid verdict
APIFY_TOKEN=                 # Apify token — AutoTrader + PistonHeads market data
FIRECRAWL_API_KEY=           # optional, used by scraping experiments
# Optional. Token allowance the tool's AI usage meter measures against — set it
# to whatever your Google AI Studio tier gives you (Google exposes no usage API
# for a key, so the total has to be declared). Unset = tokens shown, no bar.
# Apify needs no equivalent: its monthly spend + cap are read live from the API.
# GEMINI_TOKEN_BUDGET=1000000

# ── Email (Resend) ───────────────────────────────────────────────────────────
# RESEND_API_KEY=

# ── File storage (Cloudflare R2) ─────────────────────────────────────────────
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=
# NEXT_PUBLIC_R2_PUBLIC_URL=

# ── Ad conversions (optional) ────────────────────────────────────────────────
# META_PIXEL_ID=
# META_ACCESS_TOKEN=
# GOOGLE_ADS_CUSTOMER_ID=
# GOOGLE_DEV_TOKEN=
# GOOGLE_OAUTH_TOKEN=
# GOOGLE_CONVERSION_ACTION_ID=
