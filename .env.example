# Providence Auto — environment variables
# Copy to .env.local for local dev, and set the same keys on each Railway
# service (dev / staging / production). Values below are placeholders.

# ── Database (Railway Postgres) — required for app, migrations, build ─────────
# DATABASE_URL is the default the app + drizzle use.
DATABASE_URL=postgresql://user:pass@host:port/railway
DATABASE_URL_STAGING=postgresql://user:pass@host:port/railway
DATABASE_URL_PRODUCTION=postgresql://user:pass@host:port/railway

# ── Auth (Better-Auth) ───────────────────────────────────────────────────────
BETTER_AUTH_SECRET=          # any long random string
NEXT_PUBLIC_BASE_URL=        # e.g. https://providenceauto.uk.com (http://localhost:3000 for dev)
# Optional social providers:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# ── Sourcing & Profit Analyzer (admin) — REQUIRED for that tool to work ───────
# Without these, the live tool reports "GEMINI_API_KEY is not configured" /
# "APIFY_TOKEN is not configured".
GEMINI_API_KEY=              # Google AI Studio key — auction-sheet extraction + buy/avoid verdict
APIFY_TOKEN=                 # Apify token — AutoTrader + PistonHeads market data
FIRECRAWL_API_KEY=           # optional, used by scraping experiments
# Optional. Token allowance the tool's AI usage meter measures against — set it
# to whatever your Google AI Studio tier gives you (Google exposes no usage API
# for a key, so the total has to be declared). Unset = tokens shown, no bar.
# Apify needs no equivalent: its monthly spend + cap are read live from the API.
# GEMINI_TOKEN_BUDGET=1000000

# ── Email (Resend) ───────────────────────────────────────────────────────────
# RESEND_API_KEY=

# ── File storage (Cloudflare R2) ─────────────────────────────────────────────
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=
# NEXT_PUBLIC_R2_PUBLIC_URL=

# ── Ad conversions (optional) ────────────────────────────────────────────────
# Offline conversions are uploaded when the sales team labels a lead. What each
# label means lives in src/lib/leadConversion.ts.
#
# Meta. META_PIXEL_ID is the Dataset ID shown in Events Manager; the token
# should be a System User token (the one generated from the dataset's Settings
# tab expires with the admin's session).
# META_PIXEL_ID=
# META_ACCESS_TOKEN=
# Optional. Signs server calls so a stolen token cannot be replayed elsewhere.
# META_APP_SECRET=
# Set ONLY while testing. Events carrying this land in the Test Events tool and
# never reach live optimisation - leaving it set on a deployed service silently
# stops every real conversion.
# META_TEST_EVENT_CODE=
# Meta has no negative event: a junk lead is signalled by the ABSENCE of a
# QualifiedLead against the raw Lead. Turning this on sends that raw Lead from
# the server on form submit. Leave it off if the GTM container already fires a
# browser-side Lead pixel, or the denominator gets counted twice.
# META_SEND_LEAD_ON_SUBMIT=false
#
# Google Ads.
# GOOGLE_ADS_CUSTOMER_ID=
# GOOGLE_DEV_TOKEN=
# GOOGLE_OAUTH_TOKEN=
# GOOGLE_CONVERSION_ACTION_ID=
# Required only when the account is reached through a manager (MCC) account.
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Defaults to v25. Bump when Google sunsets it - unlike Meta, Google does not
# auto-upgrade a dead version, the call just fails.
# GOOGLE_ADS_API_VERSION=v25
# Google's EU consent policy names the UK explicitly. Set these to GRANTED only
# once the cookie banner actually collects that consent; unset means the field
# is omitted, which costs attribution but claims nothing untrue.
# GOOGLE_ADS_CONSENT_AD_USER_DATA=
# GOOGLE_ADS_CONSENT_AD_PERSONALIZATION=
# Sends uploads as validate-only, so nothing is recorded. Use it to check
# whether the developer token is allowlisted for offline conversions at all.
# GOOGLE_ADS_VALIDATE_ONLY=false
